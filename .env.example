APP_NAME="Vivre Pleinement"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En production : warning (debug écrit les données des requêtes dans les logs).
LOG_LEVEL=debug
# Alerte des erreurs critiques (paiement encaissé mais non traité) : renseigner
# l'URL puis passer LOG_STACK=single,slack en production.
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vivre_pleinement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production : true (cookie transmis uniquement en HTTPS) et strict.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Proxys et hôtes de confiance (voir config/security.php)
#
# Laissé vide, TRUSTED_PROXIES retombe sur les plages Cloudflare + le reverse
# proxy local : c'est le réglage attendu en production derrière Cloudflare.
# Ne renseigner que pour un autre hébergement ; `*` uniquement si l'origine
# n'accepte déjà que le proxy (pare-feu OVH filtrant les IP Cloudflare).
TRUSTED_PROXIES=
# Hôtes supplémentaires acceptés, en expressions régulières séparées par des
# virgules. L'hôte d'APP_URL et ses sous-domaines sont acceptés d'office, donc
# cette variable reste normalement vide.
TRUSTED_HOSTS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@vivre-pleinement.fr"
MAIL_FROM_NAME="Laura Baechlé"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Cashier)
# STRIPE_WEBHOOK_SECRET est obligatoire : sans lui, /stripe/* renvoie 403.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=fr_FR

BREVO_API_KEY=
BREVO_VIDEO_LIST_ID=6
BREVO_DOI_TEMPLATE_ID=6

# Clé de notification IndexNow (facultative)
INDEXNOW_KEY=

# OAuth YouTube (propriétaire de la chaîne) — requis pour récupérer les sous-titres
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Compte admin Filament initial (obligatoire pour AdminUserSeeder)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
